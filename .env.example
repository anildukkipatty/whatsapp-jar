# Needed for real replies. Without it the app still runs, and the agent posts a
# notice in the chat instead of a reply.
ANTHROPIC_API_KEY=

DATABASE_URL=postgres://jar:jar@127.0.0.1:5433/whatsapp_jar

# Signs the login cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional. Defaults shown. The thinking and effort options assume a current
# Opus, Sonnet or Fable model.
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium
# HISTORY_TOKEN_BUDGET=24000
# PROMPT_CACHE_TTL=1h
# DEBOUNCE_MS=3000
# DEBOUNCE_MAX_MS=15000

# --- Connected MCP server (optional) ---
# A remote MCP server (Streamable HTTP, no authentication) whose tools the agent
# can use in every chat, e.g. slash-dhan-mcp for Indian market data.
# MCP_URL=https://dhan-mcp-test1.slash.markets/
# With MCP_URL set the agent only discusses Indian markets. "general" keeps it an
# open assistant that also has the tools.
# AGENT_SCOPE=markets
# The server's guide for the model. Defaults to SKILL.md beside MCP_URL.
# MCP_SKILL_URL=
# Offer only these tools. Default is every tool the server lists.
# MCP_TOOLS=run_python,feed_status

# --- WhatsApp channel (npm run whatsapp) ---
# Who Jar answers. One of these two is required, or the process refuses to start.
# Numbers are digits with the country code, comma separated. Everyone else is ignored.
# WHATSAPP_ALLOWED_NUMBERS=919876543210,919812345678
# WHATSAPP_OPEN=true

# Daily limits per number. Off unless set. Cost is recorded on every turn either way.
# Suggested once it is open to the public: 30 messages and $2.
# WHATSAPP_DAILY_MESSAGES=
# WHATSAPP_DAILY_USD=
# Daily ceilings across all numbers. Off unless set.
# WHATSAPP_GLOBAL_DAILY_MESSAGES=
# WHATSAPP_GLOBAL_DAILY_USD=

# Time zone given to every WhatsApp user. Limits reset at its midnight.
# WHATSAPP_TIMEZONE=Asia/Kolkata
# Where the linked WhatsApp session is kept. Treat it like a password.
# WHATSAPP_SESSION_DIR=.whatsapp-session

# Extra arguments for Chrome, space separated. Needed only where the process runs as root:
# WHATSAPP_CHROME_ARGS=--no-sandbox
